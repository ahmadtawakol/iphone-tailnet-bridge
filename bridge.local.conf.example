# Legacy migration example only. New installations should use the menu-bar
# app or `iphone-tailnet-bridge setup`, which captures these records
# automatically and writes an owner-only JSON profile.
#
# bridge.local.conf remains gitignored because it contains pairing material,
# including authTag. Import it with:
#   iphone-tailnet-bridge import-legacy --config bridge.local.conf

IPHONE_TAILNET_IP='100.x.y.z'
IPHONE_HOSTNAME='Your-iPhone.local'
INSTANCE_UUID='REPLACE_ME'
IDENTIFIER='REPLACE_ME'
AUTH_TAG='REPLACE_ME'
VER='24'
MIN_VER='8'
FLAGS='0'

# Pairing port and bounded CoreDevice tunnel ranges for your setup.
PAIRING_PORT=49152
PORT_FIRST=55000
PORT_LAST=55400
EXTRA_PORT_FIRST=61890
EXTRA_PORT_LAST=61930
TUNNEL_PORT_FIRST=62500
TUNNEL_PORT_LAST=62531
INTERFACE=en0
